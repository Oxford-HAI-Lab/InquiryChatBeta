# Settings for Inquiry Chat.
# Copy this file to "env" (no extension) in the same folder and fill in your keys.
# The file "env" is listed in .gitignore, so your keys are not uploaded.

# Required. Used for chat, evaluation and transcription.
OPENAI_API_KEY=your-key-here

# Optional, for voice output with ElevenLabs. Leave empty and the replies are
# spoken by an OpenAI voice instead, using the key above.
ELEVENLABS_API_KEY=

# The ElevenLabs voice to speak with. The default is a custom voice made for
# Inquiry Chat, which your ElevenLabs account can only use if it has been
# shared with you. If the voice cannot be used, the app says so in the
# Terminal at startup and speaks with the OpenAI voice instead. To use a voice
# of your own, set its ID here.
# ELEVENLABS_VOICE_ID=your-voice-id

# The OpenAI voice, used when ElevenLabs is not set up or its voice is not
# available. Voices: alloy, ash, ballad, coral, echo, sage, shimmer, verse,
# marin, cedar.
# OPENAI_TTS_VOICE=ash
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Which voice service to use: auto (ElevenLabs if it works, else OpenAI),
# elevenlabs, or openai.
# TTS_PROVIDER=auto

# Optional. Uncomment a line to change its default. The chat model must accept
# the reasoning_effort parameter, which every call passes; older models that
# do not accept it fail on every turn.
# OPENAI_CHAT_MODEL=gpt-5.6-sol
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# ELEVENLABS_SEED=20260929

# Access. By default the server listens only on this computer. Set to 1 to let
# other computers and phones on your network open the web app too.
# ALLOW_NETWORK_ACCESS=1

# Voice device only. A secret the device must present to connect. The launcher
# creates one the first time it sets up a device over USB, so you do not
# normally set this by hand. Setting it also makes the server listen on the
# network, for the device alone; browsers on the network are still refused
# unless ALLOW_NETWORK_ACCESS is on. Without a token, a device can connect
# only if ALLOW_NETWORK_ACCESS is on, and then any device on the network may.
# DEVICE_TOKEN=
